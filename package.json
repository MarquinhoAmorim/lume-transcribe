{
  "name": "lume-transcribe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "python3 -m uvicorn backend.main:app --reload --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:backend": "python3 -m pytest backend/tests -q"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
